DATABASE_URL=postgresql+psycopg2://neuralhire:neuralhire_password@db:5432/neuralhire
JWT_SECRET_KEY=replace_this_with_a_long_secure_random_string_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
ALLOWED_ORIGINS=http://localhost:8501,http://localhost:3000
REQUEST_LIMIT_PER_MINUTE=60
EMBEDDING_MODEL_EN=all-mpnet-base-v2
EMBEDDING_MODEL_ML=paraphrase-multilingual-mpnet-base-v2
MATCH_THRESHOLD=0.60
LOG_LEVEL=INFO
# ── Layer 2: local LLM reasoning via Ollama (optional, additive) ──────────────
LLM_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_TIMEOUT=120
OLLAMA_CONNECT_TIMEOUT=3
