# Copy this file to .env only on the deployment host, then replace every
# REPLACE_ON_SERVER value with a freshly generated value. Never commit .env.
POSTGRES_DB=jobtest
POSTGRES_USER=jobtest
POSTGRES_PASSWORD=REPLACE_ON_SERVER_WITH_A_RANDOM_HEX_SECRET
DATABASE_URL=postgresql+psycopg2://jobtest:REPLACE_ON_SERVER_WITH_A_RANDOM_HEX_SECRET@db:5432/jobtest
JWT_SECRET_KEY=REPLACE_ON_SERVER_WITH_A_SEPARATE_RANDOM_HEX_SECRET
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
# With the same-origin Nginx proxy, this is defence in depth. Add a future HTTPS
# domain here before enabling browser access from that domain.
ALLOWED_ORIGINS=["http://20.51.167.202","http://localhost:3000"]
REQUEST_LIMIT_PER_MINUTE=60
EMBEDDING_MODEL_EN=all-mpnet-base-v2
EMBEDDING_MODEL_ML=paraphrase-multilingual-mpnet-base-v2
MATCH_THRESHOLD=0.60
LOG_LEVEL=INFO
# ── Layer 2: local LLM reasoning via Ollama (optional, additive) ──────────────
LLM_ENABLED=true
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_TIMEOUT=120
OLLAMA_CONNECT_TIMEOUT=3
