    encode zstd gzip

    request_body {
        max_size 15MB
    }

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options SAMEORIGIN
        Referrer-Policy strict-origin-when-cross-origin
    }

    handle /api/v1/* {
        reverse_proxy api:8000 {
            transport http {
                dial_timeout 10s
                response_header_timeout 180s
            }
        }
    }

    handle {
        reverse_proxy web:3000
    }
}

